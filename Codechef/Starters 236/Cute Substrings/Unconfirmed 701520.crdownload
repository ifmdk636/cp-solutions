// the longest cute substring

const fs = require('fs');

function cuteSubstring(index, string=[]) {
    const input = fs.readFileSync(0, 'utf8').split(/\s+/);
    let longestString = 0;
    if(index % 2) {
        for(let i=0; i<index.length; i++){
            if (string[i]%2 == u||o){
                longestString = longestString+string[i]
            } else if (string[i]%3 == w){
                longestString = longestString+string[i]
            }
        }
    }
}

